<audioZones portals=":vcs/portals.xml">
    <!-- A zone binds to a portal id/prefix or to a scope with interior and dimension.
         An optional box limits the scope. The first matching zone in this file wins. -->
    <!-- PS2 CDSTREAM track 18; ambient gain for areas 1 and 2. -->
    <playlist id="city" gain="12">
        <track file="audio/city.ogg" />
    </playlist>
    <!-- MAIN_1:25901 registers one of music streams 24-28 at the player position. -->
    <playlist id="shops" gain="40">
        <track file="audio/mall_1.ogg" />
        <track file="audio/mall_2.ogg" />
        <track file="audio/mall_3.ogg" />
        <track file="audio/mall_4.ogg" />
        <track file="audio/mall_5.ogg" />
    </playlist>
    <!-- The dedicated mall scope covers every floor and entrance uniformly. -->
    <zone playlist="shops">
        <portal prefix="MALL" />
    </zone>
    <zone playlist="shops" radius="200" fallback="city">
        <portal prefix="SHOPMON_" />
    </zone>
    <zone playlist="city">
        <portal prefix="KING_KNUTS_" />
        <portal id="JS_22" />
        <portal id="ARMYH" />
        <portal id="SFDOCK" />
        <portal id="COMPO" />
        <portal id="SAFE_BEACH" />
        <portal id="DTNAMU" />
        <portal id="WSAMMN" />
        <portal id="VPSHOO" />
        <portal id="JERRY" />
        <portal id="LANCE_HIDEOUT" />
    </zone>
</audioZones>
